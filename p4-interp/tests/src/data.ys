.pos 0 code
    jmp _start

.pos 0x100 code
_start:
    addq    %rcx,  %rax                 # Positive Overflow
    irmovq  $0x8000000000000000 , %rax  # MIN_INT
    subq    %rcx, %rax                  # Negative Overflow    
    ret

.pos 0x300 data
num1:
    .quad 0xAAbbccddeeff1122
num2:
    .quad 35
        
.pos 0xf00 stack
_stack:
